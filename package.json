{
  "name": "growgood-brand",
  "private": true,
  "version": "0.1.0",
  "description": "Grow Good Gardens agentic brand system",
  "type": "module",
  "scripts": {
    "tokens:seed": "node tools/extract-sass-tokens.mjs ../growgood tokens/seed/from-sass.json",
    "contrast": "node tools/contrast.mjs",
    "tokens:ramps": "node tools/build-ramps.mjs && node tools/render-color-review.mjs",
    "lint:copy": "node tools/lint-copy.mjs",
    "checks:copy": "node tools/lint-copy.mjs --report --docs brand checks _includes/gg _data/components",
    "lint:styles": "node tools/lint-styles.mjs",
    "checks:styles": "node tools/lint-styles.mjs --report _sass/gg",
    "checks:site": "node tools/checks-site.mjs",
    "checks:a11y": "node tools/a11y.mjs --report --skip reference _site",
    "preflight": "node tools/preflight.mjs --report _site",
    "judge": "node tools/brand-judge.mjs --report",
    "tokens:check": "node tools/check-tokens.mjs",
    "tokens:build": "node tools/build-tokens.mjs",
    "figma:build": "node tools/build-figma-plugin.mjs",
    "test": "npm run figma:build && node --test tests/*.test.mjs",
    "playbook:build": "node tools/build-playbook.mjs",
    "components:check": "node tools/check-components.mjs",
    "assets:check": "node tools/check-assets.mjs",
    "assets:sync": "node tools/sync-assets.mjs",
    "playbook:serve": "node tools/build-playbook.mjs && bundle exec jekyll serve --livereload",
    "site:link": "node tools/link-site.mjs",
    "site:unlink": "node tools/link-site.mjs --unlink",
    "site:serve": "node tools/link-site.mjs && cd ../growgood && bundle exec jekyll serve --livereload --port 4200"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.10.0",
    "acorn": "^8.19.0",
    "axe-core": "4.14.0",
    "htmlparser2": "9.1.0",
    "markdown-it": "14.3.3",
    "pdf-lib": "1.17.1",
    "playwright-core": "1.64.1",
    "postcss-scss": "4.0.9",
    "stylelint": "17.16.0",
    "yaml": "^2.9.1",
    "zod": "4.6.7"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2"
  }
}
